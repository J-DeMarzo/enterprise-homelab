``` Name:        SSH brute force (and whether it succeeded)
    ATT&CK:      T1110.001 (Brute Force: Password Guessing), T1078.003 (Valid Accounts: Local Accounts) on success
    Data:        index=linux sourcetype=journald (sshd)
    Cron:        */15 * * * *
    Window:      -20m@m to -5m@m
    Severity:    high if the same source then logs in with a password, medium otherwise
    Tested with: Hydra from kali against linux-victim, 4 tasks, best110.txt (2026-10-29, CASE-2026-001)
    False positives: admin logins are key-based from ops, so they never log "Failed password". A person
                 mistyping a password retries a few times, well under 10 in a window.
                 Blind spot: if the success lands in the next window with fewer than 10 failures, that
                 run sees no brute force, so the alert stays medium ```
index=linux sourcetype=journald ("Failed password" OR "Accepted password")
| rex "(?<action>Failed|Accepted) password for (?:invalid user )?(?<user>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| where isnotnull(src_ip)
| eval failed_time=if(action="Failed", _time, null()), success_time=if(action="Accepted", _time, null())
| stats count(failed_time) AS failures min(failed_time) AS first max(failed_time) AS last dc(eval(if(action="Failed", user, null()))) AS users values(user) AS user_list max(success_time) AS success_time values(eval(if(action="Accepted", user, null()))) AS success_users by src_ip host
| where failures>=10
| eval succeeded=if(isnotnull(success_time) AND success_time>=first, 1, 0)
| eval severity=if(succeeded=1, "high", "medium")
| lookup vlan_zones cidr AS src_ip OUTPUT zone AS src_zone
| eval detection="ssh_brute_force", attack=if(succeeded=1, "T1110.001, T1078.003", "T1110.001"), _time=first
| eval summary=src_ip." (".src_zone.") failed ".failures." SSH passwords on ".host." for ".users." user(s)".if(succeeded=1, ", then logged in as ".mvjoin(success_users, ", "), "")
| fields _time detection severity attack summary src_ip src_zone host failures users user_list succeeded success_users success_time first last
| collect index=soc_alerts source="detection:ssh_brute_force"
